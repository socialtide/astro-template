# Analytics (PostHog)
PUBLIC_POSTHOG_KEY=""
PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Set to "true" to enable PostHog in dev mode (off by default to avoid polluting prod analytics)
PUBLIC_POSTHOG_DEV_ENABLED=""

# Cloudflare Turnstile (required if TURNSTILE_SECRET_KEY is set in Harbor)
PUBLIC_TURNSTILE_SITE_KEY=""

# SocialTide backend (required for forms)
PUBLIC_SOCIALTIDE_CLIENT_ID=""
PUBLIC_SOCIALTIDE_API_BASE="https://harbor.socialtide.ai"
