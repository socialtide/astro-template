---
import siteData from "../../data/site.json";
import navData from "../../data/navigation.json";

const currentYear = new Date().getFullYear();

// Lucide v1 removed brand icons. Same strokes the template used before.
const socialIcons: Record<string, string> = {
  github: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>`,
  twitter: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>`,
  linkedin: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>`,
  instagram: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>`,
};
---

<footer class="bg-warm-100 border-warm-200 border-t">
  <div class="container">
    <div class="py-16 md:py-20">
      <div class="grid gap-12 md:grid-cols-4">
        <!-- Brand -->
        <div class="md:col-span-2">
          <a
            href="/"
            class="text-warm-900 hover:text-primary-600 font-serif text-2xl font-medium transition-colors"
          >
            {siteData.siteName}
          </a>
          <p class="text-body mt-4 max-w-md">
            {siteData.defaultDescription}
          </p>
          <div class="mt-8 flex gap-4">
            {
              Object.entries(siteData.socialLinks).map(([platform, url]) => {
                if (!url) return null;
                const icon = socialIcons[platform];
                if (!icon) return null;
                return (
                  <a
                    href={url}
                    class="bg-warm-200 text-warm-600 hover:bg-warm-900 hover:text-warm-50 flex h-10 w-10 items-center justify-center transition-all"
                    aria-label={platform}
                    target="_blank"
                    rel="noopener"
                    set:html={icon}
                  />
                );
              })
            }
          </div>
        </div>

        <!-- Quick Links -->
        <div>
          <h4 class="text-warm-900 font-serif text-lg font-medium">
            Quick Links
          </h4>
          <ul class="mt-6 space-y-4">
            {
              navData.mainNav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-warm-600 hover:text-warm-900 transition-colors"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Contact -->
        <div>
          <h4 class="text-warm-900 font-serif text-lg font-medium">Contact</h4>
          <ul class="text-warm-600 mt-6 space-y-4">
            {
              siteData.contact.email && (
                <li>
                  <a
                    href={`mailto:${siteData.contact.email}`}
                    class="hover:text-warm-900 transition-colors"
                  >
                    {siteData.contact.email}
                  </a>
                </li>
              )
            }
            {siteData.contact.phone && <li>{siteData.contact.phone}</li>}
            {
              siteData.contact.address && (
                <li class="text-sm leading-relaxed">
                  {siteData.contact.address}
                </li>
              )
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-warm-200 border-t py-8">
      <div
        class="text-warm-500 flex flex-col items-center justify-between gap-4 text-sm md:flex-row"
      >
        <p>
          &copy; {currentYear}
          {siteData.siteName}. All rights reserved.
        </p>
        <div class="flex items-center gap-6">
          <a href="/privacy" class="hover:text-warm-800 transition-colors">
            Privacy Policy
          </a>
          <a href="/terms" class="hover:text-warm-800 transition-colors">
            Terms of Service
          </a>
          <a
            href="https://github.com/socialtide/astro-template"
            class="hover:text-warm-800 transition-colors"
            target="_blank"
            rel="noopener"
          >
            GitHub
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
